<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="PROYECTOFINAL_API.Views.InicioView">
    <ScrollView>
        <VerticalStackLayout Padding="0,0,0,10">

            <Label Style="{StaticResource Titulo}" Text="Inicio" />
            <Label Style="{StaticResource Texto}" Text="Resumen del día y próximas entregas." Margin="0,5,0,25" />

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16" Margin="0,0,0,20">

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Texto}" Text="Pedidos pendientes" />
                        <Label Style="{StaticResource Cifra}" Text="{Binding PedidosPendientes}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Texto}" Text="Entregas de hoy" />
                        <Label Style="{StaticResource Cifra}" Text="{Binding EntregasDelDia}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Texto}" Text="Por cobrar" />
                        <Label Style="{StaticResource Cifra}" TextColor="#B5561F" Text="{Binding PorCobrar, StringFormat='{0:C}'}" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource Texto}" Text="Productos disponibles hoy" />
                        <Label Style="{StaticResource Cifra}" Text="{Binding TotalProductos}" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <Label Style="{StaticResource Subtitulo}" Text="Próximas entregas" Margin="0,5,0,10" />

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ProximasEntregas}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="110,*" ColumnSpacing="8" Padding="0,6">
                                <Label Text="{Binding FechaEntrega, StringFormat='{0:dd/MM/yyyy}'}"
                                       FontFamily="OpenSansSemibold" TextColor="#285440" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding NombreCliente}" FontFamily="OpenSansSemibold" TextColor="#212121" />
                                    <Label Style="{StaticResource Texto}" Text="{Binding ResumenProductos}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
